// The hosted Fetch website at watchfetch.tv, on Cloudflare.
//
// One Worker does three things:
//   - serves the built PWA (apps/web/dist) as static assets;
//   - forwards /api/* to the API, which runs unchanged as its Docker image in a
//     Cloudflare Container;
//   - pings that container every few minutes so it is always running, because
//     the API's scheduled jobs (Trakt poll, episode notifications, Steam sync)
//     live inside the process.
//
// Postgres is not here: a Container's disk does not survive a restart. Point
// the DATABASE_URL secret at a managed Postgres. See docs/cloudflare-deploy.md.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "fetch-web",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",

  // watchfetch.tv only. A custom domain makes Cloudflare create the DNS record
  // and certificate itself; the zone has to be in the same account. The
  // workers.dev and preview URLs are turned off so there is one address.
  "routes": [{ "pattern": "watchfetch.tv", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,

  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Without this an unknown /api path would get index.html from the SPA
    // fallback instead of reaching the API.
    "run_worker_first": ["/api", "/api/*", "/addon", "/addon/*"]
  },

  "containers": [
    {
      "class_name": "ApiContainer",
      // The same Dockerfile the self-hosted image is built from. Its last stage
      // is the API runtime, so no build target is needed. The build context is
      // web/, as for `docker build`.
      "image": "../api/Dockerfile",
      "image_build_context": "../..",
      // 1/4 vCPU, 1 GiB. Enough for one API process; CPU is billed only when
      // used, memory for as long as the container runs.
      "instance_type": "basic",
      // Exactly one. The API keeps its schedulers, locks and caches in process
      // memory, which is only correct with a single copy of it running.
      "max_instances": 1
    }
  ],

  "durable_objects": {
    "bindings": [{ "name": "API", "class_name": "ApiContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ApiContainer"] }],

  // Keeps the API container started: after a deploy rollout, a crash, or
  // anything else that stopped it.
  "triggers": { "crons": ["*/5 * * * *"] },

  "vars": {
    "PUBLIC_ORIGIN": "https://watchfetch.tv"
  },

  "observability": { "enabled": true }
}
