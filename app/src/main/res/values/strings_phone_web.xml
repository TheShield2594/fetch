    <!-- Addons -->
    <string name="phone_web_addons_title">Addons</string>
    <string name="phone_web_addons_intro">Streams come from addons. Paste an addon’s link (it usually ends in manifest.json) and the TV shows what it is and asks before installing it. Debrid services such as Real-Debrid, Premiumize and TorBox are signed in on the addon’s own setup page.</string>
