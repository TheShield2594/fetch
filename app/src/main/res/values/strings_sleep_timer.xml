<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Player: the sleep timer button in the More row. A press opens the list below. -->
    <string name="player_sleep_timer">Sleep timer</string>
    <plurals name="player_sleep_timer_minutes_left">
        <item quantity="one">Sleep timer: %d min left</item>
        <item quantity="other">Sleep timer: %d min left</item>
    </plurals>
    <string name="player_sleep_timer_end_of_episode">Sleep timer: end of this episode</string>
    <string name="player_sleep_timer_end_of_movie">Sleep timer: end of this movie</string>

    <!-- Player: the sleep timer list. "Off" comes first so cancelling takes two presses. -->
    <string name="player_sleep_timer_off">Off</string>
    <plurals name="player_sleep_timer_choice_minutes">
        <item quantity="one">%d minute</item>
        <item quantity="other">%d minutes</item>
    </plurals>
    <string name="player_sleep_timer_choice_end_of_episode">End of this episode</string>
    <string name="player_sleep_timer_choice_end_of_movie">End of this movie</string>

    <!-- Player: the prompt when the sleep timer runs out. The title is still_watching_title. -->
    <plurals name="player_sleep_timer_prompt">
        <item quantity="one">The sleep timer paused playback. The player closes in %d second.</item>
        <item quantity="other">The sleep timer paused playback. The player closes in %d seconds.</item>
    </plurals>
    <string name="player_sleep_timer_keep_watching">Keep watching</string>
    <plurals name="player_sleep_timer_extend">
        <item quantity="one">%d more minute</item>
        <item quantity="other">%d more minutes</item>
    </plurals>
    <string name="player_sleep_timer_stop">Stop</string>
</resources>
