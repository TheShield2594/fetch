{
  "name": "@fetch/api",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "prisma migrate deploy && node dist/index.js",
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "lint": "prisma generate && eslint src",
    "test": "prisma generate && vitest run",
    "test:int": "prisma generate && vitest run --config vitest.int.config.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push"
  },
  "dependencies": {
    "@fetch/shared": "workspace:*",
    "@fastify/compress": "^9.3.0",
    "@fastify/rate-limit": "^11.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "fastify": "^5.12.8",
    "lru-cache": "^11.5.3",
    "pg": "^8.23.1",
    "undici": "^8.12.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
